PORT=5000

# Required: MongoDB connection string (Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MAPBOX_TOKEN=your_mapbox_token
NVIDIA_API_KEY=your_nvidia_api_key
# SMTP for reminder emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=DevOS <noreply@yourdomain.com>
GROQ_API_KEY=your_groq_api_key
GROQ_AGENT_MODEL=openai/gpt-oss-20b
GROQ_COMPLEX_AGENT_MODEL=openai/gpt-oss-20b
GROQ_CAPABILITY_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
GROQ_INTENT_MODEL=openai/gpt-oss-20b
GROQ_BLUEPRINT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Required
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CORS_ORIGIN=http://localhost:5173

# Google Drive OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:5000
# Required: Strong random 32-byte key for encrypting stored OAuth tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=<64-char-hex-string>

# Qdrant vector database (project knowledge / PRD RAG)
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=devos_knowledge

# GitHub App (OAuth user-to-server; keep secrets backend-only)
GITHUB_APP_ID=your_github_app_id
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:5000/api/integrations/github/callback
GITHUB_APP_SLUG=devos
GITHUB_PRIVATE_KEY=
