# DevOS Frontend Environment Configuration

# Optional: Mapbox Access Token for UI telemetry maps
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Optional: Clerk Authentication Publishable Key
# If omitted or left unconfigured, DevOS automatically runs in Guest Demo Mode
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Optional: Backend REST API Endpoint (defaults to http://localhost:5000/api)
# When set, API calls target the live Node/Express backend. If unreachable, Demo Mode fallback activates.
VITE_API_BASE_URL=http://localhost:5000/api

# Electron desktop OAuth redirect URL for Clerk Dashboard (Paths & Redirects → Allowed redirect URLs):
#   http://127.0.0.1/sso-callback
