VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BYPASS_AUTH=false

# Electron desktop OAuth: add this redirect URL in the Clerk Dashboard
# (Paths & Redirects → Allowed redirect URLs):
#   http://127.0.0.1/sso-callback
# Clerk accepts dynamic loopback ports per RFC 8252 when the host is 127.0.0.1.
